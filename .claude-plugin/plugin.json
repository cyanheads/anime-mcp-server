{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "anime-mcp-server",
  "version": "0.2.0",
  "description": "Search anime/manga, get full detail, franchise watch order, seasonal schedule, characters, rankings, and studio filmography via MCP. STDIO or Streamable HTTP.",
  "author": {
    "name": "Casey Hand",
    "email": "casey@caseyjhand.com",
    "url": "https://caseyjhand.com"
  },
  "homepage": "https://github.com/cyanheads/anime-mcp-server#readme",
  "repository": "https://github.com/cyanheads/anime-mcp-server",
  "license": "Apache-2.0",
  "keywords": ["mcp", "mcp-server", "model-context-protocol"],
  "mcpServers": {
    "anime-mcp-server": {
      "command": "npx",
      "args": ["-y", "@cyanheads/anime-mcp-server"],
      "env": {
        "MCP_TRANSPORT_TYPE": "stdio"
      }
    }
  }
}
